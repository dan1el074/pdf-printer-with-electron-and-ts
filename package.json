{
  "name": "imprime-pdf",
  "version": "4.0.3",
  "description": "Um aplicativo já existente, mas escrito em Typescript",
  "scripts": {
    "build": "tsc && node src/scripts/copy-assets.cjs",
    "build:dev": "npm run build",
    "watch:dev": "tsc -w",
    "start:dev": "npm run build:dev && electron ./dist/main.js",
    "build:prod": "npm run build:dev && cd dist && npm install && npm run build:prod && npm run config:prod"
  },
  "keywords": [
    "Electron",
    "typescript"
  ],
  "author": "Daniel Rodrigues de Vargas",
  "devDependencies": {
    "@electron-forge/cli": "^7.3.0",
    "@types/node": "^20.14.10",
    "electron": "^28.1.0",
    "globals": "^15.8.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "fs": "^0.0.1-security",
    "pdf-lib": "^1.17.1",
    "pdf-to-printer": "^5.6.0",
    "xlsx": "^0.18.5"
  }
}
